**/.return-meta.json
# Runtime logs relocated out of .claude/.opencode so they survive a wipe (see
# agent-system/extensions/core/docs/architecture/extension-system.md)
/.agent-logs/
# Staging directory for the settings.json/settings.local.json backup/restore
# wrapper (settings_backup.lua) used across a full .claude/.opencode wipe.
/.claude-settings-backup/
/.opencode-settings-backup/
/specs/tmp
/.claude/tmp/
/.opencode/tmp/
**/.postflight-pending
**/.git-snapshot-marker
.syncprotect
specs/literature/**/*.pdf
specs/literature/**/*.djvu
# Literature SQLite databases (ephemeral - rebuilt from chunk files)
.literature.db
.literature.db.tmp
specs/literature/.literature.db
specs/literature/.literature.db.tmp
# literature-convert.sh pymupdf4llm engine venv (auto-provisioned by
# literature-pyenv-provision.sh; never commit — see task 831)
.claude/scripts/literature-pyenv/
__pycache__/
*.pyc
