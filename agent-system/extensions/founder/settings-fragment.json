{
  "mcpServers": {
    "sec-edgar": {
      "command": "npx",
      "args": [
        "-y",
        "@stefanoamorelli/sec-edgar-mcp"
      ],
      "env": {}
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  },
  "permissions": {
    "allow": [
      "mcp__firecrawl__scrape",
      "mcp__firecrawl__crawl",
      "mcp__firecrawl__map",
      "mcp__firecrawl__extract",
      "mcp__sec-edgar__*"
    ]
  }
}
